# Netora — Environment Configuration (VPS / production reference)
# Copy this file to `.env` and fill in real values before running the app.
# NEVER commit the real `.env` file to git (it is already in .gitignore).

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB — required)
# ---------------------------------------------------------------------------
# Full connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://netora:change-me@localhost:3306/netora

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). Generate a strong random value:
#   openssl rand -base64 48
# Changing this invalidates every existing session (forces re-login).
JWT_SECRET=replace-with-a-long-random-string

# Email address that is automatically promoted to the "admin" role the first
# time it registers. Leave empty to disable automatic admin promotion.
OWNER_EMAIL=owner@yourcompany.com

NODE_ENV=production

# ---------------------------------------------------------------------------
# Secrets vault (required — used to encrypt MikroTik/RADIUS credentials)
# ---------------------------------------------------------------------------
# A 32-byte encryption key for AES-256-GCM, either 64 hex chars or base64.
# Generate one with:
#   openssl rand -hex 32
# Losing/rotating this key makes previously-stored router credentials and
# integration secrets unreadable — back it up securely (e.g. a secrets
# manager), separate from your database backups.
SECRET_ENCRYPTION_KEY=replace-with-a-32-byte-hex-or-base64-key

# ---------------------------------------------------------------------------
# Object storage (S3-compatible — required for file uploads/exports)
# ---------------------------------------------------------------------------
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces.
# Examples:
#   AWS S3:        https://s3.<region>.amazonaws.com   (S3_FORCE_PATH_STYLE=false)
#   Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com (S3_FORCE_PATH_STYLE=true)
#   MinIO (self-hosted): https://minio.yourdomain.com   (S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_BUCKET=netora-uploads
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Optional: RADIUS accounting shared secret verification
# ---------------------------------------------------------------------------
# There is no dedicated env var here — the RADIUS shared secret used to
# verify incoming /api/radius/accounting events is configured per-tenant
# through the app's "Integrations" panel (stored encrypted via
# SECRET_ENCRYPTION_KEY above), not as a global environment variable.
# See README.md "RADIUS accounting setup" for the FreeRADIUS-side wiring.
